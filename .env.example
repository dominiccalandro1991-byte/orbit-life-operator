# App
NODE_ENV=development
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-32-plus-char-secret

# Database (Neon Postgres)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Stripe — leave STRIPE_WEBHOOK_SECRET empty until webhooks are live.
# Payment routes return 503 "Billing setup pending" when the secret is missing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Inference (AI SDK / Gateway). Do not grant Pro via client flags.
AI_GATEWAY_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=

# Optional BYOK (user-supplied keys stay server-side; never persist in localStorage)
USER_INFERENCE_KEY=

# Optional production hosts
VERCEL_URL=
VERCEL_PROJECT_PRODUCTION_URL=
